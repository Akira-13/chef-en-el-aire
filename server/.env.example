# Copia este archivo como server/.env y completa los valores.
# La clave nunca se envía al cliente: solo la usa el Gateway LLM.

# Proveedor remoto (DeepSeek, API compatible con OpenAI). Modelos: https://api-docs.deepseek.com/
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Proveedor local opcional (Ollama).
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# Puerto del servidor. Por defecto 3001 en desarrollo y 3000 con `npm start`.
PORT=
